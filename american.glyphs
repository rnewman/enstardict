12	ā
56	ä
107	e
113	ē
64	i
130	ī
97	o
86	ō
99	ŏ
76	ô
146	u
39	ə
52	ə
244	œ
97,86	o͞o	"boot", "cute" -- macron spanning both o's
97,99	o͝o	"book"

